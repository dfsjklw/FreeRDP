<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!-- children are specified bottom-up so that we have a correct z-order in our final layout -->
    <com.freerdp.freerdpcore.presentation.ExtendedKeyboardView
        android:id="@+id/extended_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone" />

    <com.freerdp.freerdpcore.presentation.ScrollView2D
        android:id="@+id/sessionScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/extended_keyboard"
        android:layout_alignParentTop="true"
        android:drawingCacheQuality="low"
        android:isScrollContainer="true"
        android:scrollbars="horizontal|vertical">

        <FrameLayout
            android:id="@+id/railContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.freerdp.freerdpcore.presentation.SessionView
                android:id="@+id/sessionView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawingCacheQuality="low"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </FrameLayout>

    </com.freerdp.freerdpcore.presentation.ScrollView2D>

    <com.freerdp.freerdpcore.presentation.TouchPointerView
        android:id="@+id/touchPointerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <!-- Pan grip above the keyboard: a thin, barely visible bar inside a larger touch
         target, so the session picture can still be moved while the keyboard covers the
         lower part of the screen. -->
    <FrameLayout
        android:id="@+id/session_pan_handle"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/session_pan_handle"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="center_vertical"
            android:alpha="0.08"
            android:background="#FFFFFFFF" />
    </FrameLayout>

    <include
        layout="@layout/floating_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />

</RelativeLayout>
